# Copy to .env. Never commit the real file: .gitignore already blocks it.
#
# EVERYTHING WORKS WITH THIS FILE EMPTY.
#
#   uv run toolsmith matrix run --provider simulated
#
# reproduces every published table, chart and transcript for $0 and no keys.
# Keys are what let you re-measure the same tables live, through the identical
# code path.
#
# The ledger in configs/budget.yaml refuses any call that would take cumulative
# live spend past $20. That is enforced before the request goes out.

# --- primary live provider ---------------------------------------------------
# Groq is the workhorse: gpt-oss-20b at $0.075/$0.30 per million, 1,000 TPS,
# strict JSON schema support, and a free tier bounded by 200k tokens per day
# (roughly 80 real agent turns). Cached tokens do not count against that limit.
GROQ_API_KEY=

# --- the frontier comparison row ---------------------------------------------
# Without at least one of these there is no "versus frontier" claim to make.
# Around $3 to $5 covers the evaluation and escalation calls.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- judge seats -------------------------------------------------------------
# The panel must be family-disjoint from the system under test.
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# --- optional ----------------------------------------------------------------
TOGETHER_API_KEY=

# Local Apple-silicon inference. No key; start the server yourself:
#   uv run mlx_lm.server --model mlx-community/Qwen3.5-4B-Instruct-4bit --port 8080
TOOLSMITH_MLX_BASE_URL=http://127.0.0.1:8080/v1
